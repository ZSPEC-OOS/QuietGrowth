# QuietGrowth environment (MR Appendix A). Copy to .env. Never commit real values.

# Core
DATABASE_URL=postgres://postgres:quietgrowth@postgres:5432/quietgrowth   # role must be able to SET ROLE qg_app (see docs/DEPLOYMENT.md)
REDIS_URL=redis://redis:6379
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=                 # >= 32 random bytes; signs session tokens
INTERNAL_SECRET=                # MASTER for /internal/*; each tenant cell receives only HMAC(master, "internal:"+orgId)
ACTION_AUTH_SECRET=             # signs action authorisation tokens
SECRET_MASTER_KEY=              # base64, 32 bytes: `openssl rand -base64 32`

# Model / runtime
DEEPSEEK_API_KEY=               # BYOK; per-tenant keys are stored encrypted by reference, this is for dev/test tenants
OPENCLAW_IMAGE=                 # pinned tag or digest, never :latest
OPENCLAW_GATEWAY_BASE_PORT=20000
OPENCLAW_RUNTIME_MODE=docker    # docker | attested-local
OPENCLAW_ALLOWED_IMAGES=        # comma-separated pinned images the admin app will accept
RUNTIME_ATTESTED=0              # 1 = self-host owner attests the runtime for the readiness check

# Admin (internal)
ADMIN_DATABASE_URL=             # login role that is a member of qg_admin
ADMIN_TOKEN=                    # >= 24 chars

# Secrets / storage
SECRET_STORE_PROVIDER=local
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=

# Connectors
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
STRIPE_CLIENT_ID=
EMAIL_CONNECTOR_CLIENT_ID=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKER_DSN=
